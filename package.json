{
  "name": "website-bewerbung-programmfinder",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2019 --outfile=dist/finder.js",
    "dev": "esbuild src/index.ts --bundle --format=iife --target=es2019 --outfile=demo/finder.js --servedir=demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
